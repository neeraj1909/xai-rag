# XAI-RAG Configuration
# Copy to .env and fill in your values

# LLM Provider
XAI_RAG_LLM_PROVIDER=openai
XAI_RAG_LLM_MODEL=gpt-4o-mini
XAI_RAG_LLM_BASE_URL=
XAI_RAG_OPENAI_API_KEY=replace-with-your-provider-key

# ChromaDB
XAI_RAG_CHROMA_HOST=localhost
XAI_RAG_CHROMA_PORT=8100
XAI_RAG_CHROMA_COLLECTION=xai_rag_documents

# Elasticsearch
XAI_RAG_ELASTICSEARCH_URL=http://localhost:9200
XAI_RAG_ELASTICSEARCH_INDEX=xai_rag_documents
XAI_RAG_ELASTICSEARCH_API_KEY=

# Models
# Pinned repository defaults. The reranker is sizeable even on CPU; see
# docs/model-inventory.md. Evaluate any replacement on representative data,
# pin its full revision, update the embedding dimension if applicable, and
# reindex rather than assuming that a larger model is production-better.
XAI_RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
XAI_RAG_EMBEDDING_DIMENSION=384
XAI_RAG_EMBEDDING_MODEL_REVISION=5c38ec7c405ec4b44b94cc5a9bb96e735b38267a
XAI_RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
XAI_RAG_RERANKER_MODEL_REVISION=953dc6f6f85a1b2dbfca4c34a2796e7dde08d41e
XAI_RAG_NLI_MODEL=MoritzLaurer/DeBERTa-v3-base-mnli-fever-anli
XAI_RAG_NLI_MODEL_REVISION=6f5cf0a2b59cabb106aca4c287eed12e357e90eb
XAI_RAG_NLI_ENTAILMENT_THRESHOLD=0.5
XAI_RAG_NLI_CONTRADICTION_THRESHOLD=0.5
XAI_RAG_CHUNKING_MODEL_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
XAI_RAG_RERANKER_CANDIDATE_K=5

# Observability
XAI_RAG_OTEL_ENDPOINT=
XAI_RAG_OTEL_SERVICE_NAME=xai-rag
XAI_RAG_OTEL_INSECURE=false

# API security
# Generate with: openssl rand -hex 32
XAI_RAG_API_KEY=replace-with-a-random-64-character-key
XAI_RAG_API_HOST=127.0.0.1
XAI_RAG_API_PORT=8000
XAI_RAG_HOST_PORT=8000
XAI_RAG_CORS_ORIGINS=
XAI_RAG_EXPOSE_DOCS=false
XAI_RAG_INGEST_ROOT=./sample_docs
XAI_RAG_RATE_LIMIT_PER_MINUTE=60
XAI_RAG_LLM_TIMEOUT_SECONDS=60
XAI_RAG_LLM_CONTEXT_MAX_CHARS=32000
XAI_RAG_QUERY_TIMEOUT_SECONDS=120
XAI_RAG_MAX_CONCURRENT_QUERIES=4
XAI_RAG_MAX_INGEST_FILES=100
XAI_RAG_MAX_DOCUMENT_BYTES=20000000
XAI_RAG_MAX_INGEST_TOTAL_BYTES=100000000
# Keep request-path evaluation off; use `xai-rag evaluate` for normal evaluation runs.
XAI_RAG_ALLOW_REQUEST_EVALUATION=false
