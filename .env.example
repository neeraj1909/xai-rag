# XAI-RAG Configuration
# Copy to .env and fill in your values

# LLM Provider
XAI_RAG_LLM_PROVIDER=openai
XAI_RAG_LLM_MODEL=gpt-4o-mini
XAI_RAG_OPENAI_API_KEY=sk-your-key-here
# XAI_RAG_LLM_PROVIDER=anthropic
# XAI_RAG_ANTHROPIC_API_KEY=sk-ant-your-key-here

# ChromaDB
XAI_RAG_CHROMA_HOST=localhost
XAI_RAG_CHROMA_PORT=8100
XAI_RAG_CHROMA_COLLECTION=xai_rag_documents

# Elasticsearch
XAI_RAG_ELASTICSEARCH_URL=http://localhost:9200

# Redis
XAI_RAG_REDIS_URL=redis://localhost:6379

# Models
# Lightweight models for development (CPU-friendly)
XAI_RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
XAI_RAG_EMBEDDING_DIMENSION=384
XAI_RAG_RERANKER_MODEL=BAAI/bge-reranker-base
XAI_RAG_NLI_MODEL=MoritzLaurer/DeBERTa-v3-base-mnli-fever-anli

# Production models (GPU recommended):
# XAI_RAG_EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
# XAI_RAG_EMBEDDING_DIMENSION=1024
# XAI_RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# XAI_RAG_NLI_MODEL=MoritzLaurer/DeBERTa-v3-large-mnli-fever-anli-ling-wanli

# Observability
XAI_RAG_OTEL_ENDPOINT=http://localhost:4317
XAI_RAG_OTEL_SERVICE_NAME=xai-rag
