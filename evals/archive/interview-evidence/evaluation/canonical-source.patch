 EventSink = Callable[[str, dict[str, Any]], Awaitable[None]]
 
+# The indexes identify a source by its relative source_file, including when
+# requests use different roots. Locks are scoped to one event loop/process;
+# multiple workers still require a durable lease and reconciliation.
+_ingestion_locks: weakref.WeakValueDictionary[
+    tuple[asyncio.AbstractEventLoop, str], asyncio.Lock
+] = weakref.WeakValueDictionary()
+_ingestion_locks_guard = threading.Lock()
+
+
+def _ingestion_lock(source_file: str) -> asyncio.Lock:
+    key = (asyncio.get_running_loop(), source_file)
+    with _ingestion_locks_guard:
+        lock = _ingestion_locks.get(key)
+        if lock is None:
+            lock = asyncio.Lock()
+            _ingestion_locks[key] = lock
+        return lock
+
+
+async def _finish_ingestion_write(work: Awaitable[None]) -> None:
+    """Keep the source lock until a cancelled ES request has finished locally.
+
+    A network failure can still leave the remote write outcome unknown; this is
+    not a cross-store transaction or a distributed lease.
+    """
+    task = asyncio.ensure_future(work)
+    try:
+        await asyncio.shield(task)
+    except asyncio.CancelledError:
+        while not task.done():
+            try:
+                await asyncio.shield(task)
+            except asyncio.CancelledError:
+                continue
+            except Exception:
+                break
+        if not task.cancelled():
+            task.exception()
+        raise
+
 
