+class _EvidenceTooLongError(ValueError):
+    """A premise and claim do not fit the NLI model without truncation."""
+
+
+def _evidence_windows(content: str) -> list[str]:
+    """Return individual and adjacent passages, preserving all visible text.
+
+    Headings remain units rather than treating numbers in them as sentences.
+    If the limit is exceeded the caller must withhold, not silently drop text.
+    """
+    parts: list[str] = []
+    for line in content.splitlines():
+        line = line.strip()
+        if not line:
+            continue
+        if line.startswith("#"):
+            parts.append(line)
+        else:
+            parts.extend(part for part in re.split(r"(?<=[.!?])\s+", line) if part)
+    windows = parts + [
+        f"{first}\n{second}" for first, second in zip(parts, parts[1:], strict=False)
+    ]
+    return list(dict.fromkeys(windows))
 
 
